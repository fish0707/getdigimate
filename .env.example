# Sanity（未填時前台自動使用本機 fixture 假資料）
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# 伺服器端寫入用（訂單、庫存），勿加 NEXT_PUBLIC 前綴
SANITY_API_WRITE_TOKEN=

# 金流 — 綠界 ECPay（M3 里程碑，先留測試環境金鑰）
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_ENV=stage

# 行銷（M5）
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
